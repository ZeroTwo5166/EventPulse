{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "Acks": "All",
    "EnableIdempotence": true,
    "MessageSendMaxRetries": 3,
    "ProduceTimeout": "00:00:05",
    "HealthTimeout": "00:00:02"
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "RateLimit": {
    "Limit": 100,
    "Window": "00:00:10",
    "Timeout": "00:00:00.200"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "Acks": "All",
    "EnableIdempotence": true,
    "MessageSendMaxRetries": 3,
    "ProduceTimeout": "00:00:05",
    "HealthTimeout": "00:00:02"
  }
}

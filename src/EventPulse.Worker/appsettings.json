{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Host": {
    "ShutdownTimeout": "00:00:10",
    "ServicesStopConcurrently": true
  },
  "ConnectionStrings": {
    "Ledger": "Host=localhost;Port=5432;Database=eventpulse;Username=eventpulse;Timeout=2;Command Timeout=2"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "GroupId": "order-ledger",
    "NotificationsGroupId": "order-notifications",
    "EnableAutoCommit": false,
    "AutoOffsetReset": "Earliest",
    "MaxPollIntervalMs": 300000,
    "Acks": "All",
    "EnableIdempotence": true,
    "MessageSendMaxRetries": 3
  },
  "Retry": {
    "Attempts": 6,
    "BaseDelay": "00:00:00.500",
    "MaxDelay": "00:00:08",
    "Deadline": "00:04:00"
  }
}
